.create-page {
  padding-top: 28rpx;
}

.create-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42rpx;
}

.back {
  color: #0b1f3a;
  font-size: 56rpx;
  line-height: 32rpx;
  width: 80rpx;
}

.create-title {
  font-size: 32rpx;
  font-weight: 700;
}

.field-label {
  color: #6f7d91;
  font-size: 23rpx;
  font-weight: 650;
  margin: 12rpx 0;
}

.select-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 82rpx;
  border: 2rpx solid #e1e7ee;
  border-radius: 12rpx;
  color: #0b1f3a;
  font-size: 27rpx;
  margin-bottom: 26rpx;
  padding: 0 20rpx;
}

.arrow {
  color: #778398;
  font-size: 36rpx;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stepper button {
  background: #f1f4f8;
  border-radius: 50%;
  color: #0b1f3a;
  font-size: 30rpx;
  height: 48rpx;
  line-height: 44rpx;
  padding: 0;
  width: 48rpx;
}

.create-note {
  line-height: 1.7;
  margin: 12rpx 8rpx 36rpx;
}
