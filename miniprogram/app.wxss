page {
  background: #f6f8fb;
  color: #0b1f3a;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Arial, sans-serif;
}

view,
text,
button,
input,
picker {
  box-sizing: border-box;
}

button::after {
  border: 0;
}

.page {
  min-height: 100vh;
  padding: 32rpx 36rpx 48rpx;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.brand {
  font-size: 35rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.muted {
  color: #778398;
}

.small {
  font-size: 24rpx;
  line-height: 1.5;
}

.trust-line {
  display: flex;
  align-items: center;
  color: #6f7d91;
  font-size: 24rpx;
  margin-bottom: 40rpx;
}

.trust-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #35a565;
  margin-right: 14rpx;
}

.route-panel {
  display: flex;
  align-items: stretch;
  margin-bottom: 42rpx;
}

.route-rail {
  width: 34rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 12rpx;
}

.route-dot {
  width: 22rpx;
  height: 22rpx;
  border: 6rpx solid #35a565;
  border-radius: 50%;
  background: #fff;
}

.route-dot.end {
  border-color: #0b1f3a;
  border-radius: 6rpx;
}

.route-line {
  flex: 1;
  width: 4rpx;
  min-height: 56rpx;
  border-left: 4rpx dashed #9fb4a6;
}

.route-copy {
  padding-left: 20rpx;
}

.route-title {
  font-size: 32rpx;
  font-weight: 650;
  line-height: 1.3;
}

.route-subtitle {
  color: #778398;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.ride-card,
.form-card,
.detail-card {
  background: #fff;
  border: 2rpx solid #e8edf3;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.ride-card:active {
  background: #fbfcfe;
}

.ride-card-head,
.ride-card-meta,
.row-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.time {
  color: #248c53;
  font-size: 30rpx;
  font-weight: 700;
}

.ride-route {
  font-size: 29rpx;
  font-weight: 650;
  margin: 20rpx 0;
}

.meta-box {
  background: #f6f8fb;
  border-radius: 12rpx;
  color: #536176;
  font-size: 23rpx;
  padding: 14rpx 16rpx;
}

.primary-button,
.secondary-button {
  width: 100%;
  border-radius: 14rpx;
  font-size: 29rpx;
  font-weight: 650;
  line-height: 1;
  padding: 28rpx 24rpx;
}

.primary-button {
  background: #0b1f3a;
  color: #fff;
}

.secondary-button {
  background: #fff;
  border: 2rpx solid #0b1f3a;
  color: #0b1f3a;
}

.button-stack {
  margin-top: 30rpx;
}

.button-stack button + button {
  margin-top: 16rpx;
}

.empty-state {
  background: #fff;
  border: 2rpx dashed #d9e1eb;
  border-radius: 20rpx;
  padding: 44rpx 28rpx;
  text-align: center;
  color: #778398;
}
