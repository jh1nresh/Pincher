# The landing page and public MCP discovery run without credentials.

# Browser-backed trip data (optional for a static preview).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for Telegram rides and authenticated MCP ride tools.
SUPABASE_SERVICE_ROLE_KEY=

# Required for the Telegram webhook.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Required for the cleanup endpoint and cleanup worker.
CRON_SECRET=
PINCHER_CLEANUP_URL=https://your-domain.example/api/telegram/webhook?task=close-expired

# Required to enable MCP ride lookup and mutation tools.
MCP_API_KEY=

# Optional scope and geocoding controls.
TELEGRAM_ALLOWED_CHAT_IDS=
GOOGLE_MAPS_API_KEY=
